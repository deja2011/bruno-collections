settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Update Isolated Margin

  POST /exchange (signed action template)

  Add or remove isolated margin. ntli is signed and scaled by 1e6.

  Reference: https://hyperliquid.gitbook.io/hyperliquid-docs/for-developers/api/exchange-endpoint
}
