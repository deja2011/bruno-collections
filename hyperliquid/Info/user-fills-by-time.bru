meta {
  name: User Fills By Time
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/info
  body: json
  auth: inherit
}

body:json {
  {
    "type": "userFillsByTime",
    "user": "0x0000000000000000000000000000000000000000",
    "startTime": 1700000000000,
    "endTime": 1700086400000,
    "aggregateByTime": false
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  User Fills By Time

  POST /info (public Info request)

  Retrieve fills in a time range. The response is capped by the API.

  Reference: https://hyperliquid.gitbook.io/hyperliquid-docs/for-developers/api/info-endpoint
