meta {
  name: Vault Details
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/info
  body: json
  auth: inherit
}

body:json {
  {
    "type": "vaultDetails",
    "vaultAddress": "0x0000000000000000000000000000000000000000",
    "user": "0x0000000000000000000000000000000000000000"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Vault Details

  POST /info (public Info request)

  Retrieve vault details. The user field is optional.

  Reference: https://hyperliquid.gitbook.io/hyperliquid-docs/for-developers/api/info-endpoint
}
