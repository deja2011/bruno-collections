meta {
  name: All Mids
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/info
  body: json
  auth: inherit
}

body:json {
  {
    "type": "allMids"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  All Mids

  POST /info (public Info request)

  Retrieve mids for all coins. Optional field: dex.

  Reference: https://hyperliquid.gitbook.io/hyperliquid-docs/for-developers/api/info-endpoint
}
