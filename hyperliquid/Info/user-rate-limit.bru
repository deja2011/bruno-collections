meta {
  name: User Rate Limit
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/info
  body: json
  auth: inherit
}

body:json {
  {
    "type": "userRateLimit",
    "user": "0x0000000000000000000000000000000000000000"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  User Rate Limit

  POST /info (public Info request)

  Query the user's address-based request usage and cap.

  Reference: https://hyperliquid.gitbook.io/hyperliquid-docs/for-developers/api/info-endpoint
}
