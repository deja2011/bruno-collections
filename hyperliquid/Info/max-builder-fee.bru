meta {
  name: Max Builder Fee
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/info
  body: json
  auth: inherit
}

body:json {
  {
    "type": "maxBuilderFee",
    "user": "0x0000000000000000000000000000000000000000",
    "builder": "0x0000000000000000000000000000000000000000"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Max Builder Fee

  POST /info (public Info request)

  Check builder fee approval for a user and builder.

  Reference: https://hyperliquid.gitbook.io/hyperliquid-docs/for-developers/api/info-endpoint
}
