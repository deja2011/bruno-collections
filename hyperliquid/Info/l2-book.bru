meta {
  name: L2 Book
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/info
  body: json
  auth: inherit
}

body:json {
  {
    "type": "l2Book",
    "coin": "SP500",
    "nSigFigs": 5,
    "mantissa": null
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  L2 Book

  POST /info (public Info request)

  Retrieve an L2 order book snapshot. Returns at most 20 levels per side.

  Reference: https://hyperliquid.gitbook.io/hyperliquid-docs/for-developers/api/info-endpoint
}
