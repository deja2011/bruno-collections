meta {
  name: Historical Orders
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/info
  body: json
  auth: inherit
}

body:json {
  {
    "type": "historicalOrders",
    "user": "0x0000000000000000000000000000000000000000"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Historical Orders

  POST /info (public Info request)

  Retrieve at most 2000 most recent historical orders.

  Reference: https://hyperliquid.gitbook.io/hyperliquid-docs/for-developers/api/info-endpoint
}
