meta {
  name: WS Post Info L2 Book
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/info
  body: json
  auth: inherit
}

body:json {
  {
    "method": "post",
    "id": 123,
    "request": {
      "type": "info",
      "payload": {
        "type": "l2Book",
        "coin": "ETH",
        "nSigFigs": 5,
        "mantissa": null
      }
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  WS Post Info L2 Book

  POST /info (public Info request)

  Example payload for posting an Info request over WebSocket. Use wss://api.hyperliquid.xyz/ws in Bruno's WebSocket client.

  Reference: https://hyperliquid.gitbook.io/hyperliquid-docs/for-developers/api/info-endpoint
}
