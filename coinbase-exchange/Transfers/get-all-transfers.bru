meta {
  name: Get all transfers
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/transfers?limit=30&type=deposit
  body: none
  auth: inherit
}

params:query {
  limit: 30
  type: deposit
  ~profile_id: 
  ~before: 
  ~after: 
  ~currency_type: 
  ~transfer_reason: 
  ~currency: BTC
}

settings {
  encodeUrl: true
}

docs {
  Get all transfers

  GET /transfers (requires API key authentication)

