meta {
  name: Get Funding Rate History
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/fapi/v1/fundingRate
  body: none
  auth: inherit
}

params:query {
  ~symbol: BTCUSDT
  ~startTime: 1623319461670
  ~endTime: 1641782889000
  ~limit: 50
}

settings {
  encodeUrl: true
}

docs {
  Get Funding Rate History

  GET /fapi/v1/fundingRate (public — no API key required)

  Query parameters:
  - symbol (optional, example: BTCUSDT)
  - startTime (optional, example: 1623319461670) — Timestamp in ms to get funding rate from INCLUSIVE.
  - endTime (optional, example: 1641782889000) — Timestamp in ms to get funding rate until INCLUSIVE.
  - limit (optional, example: 50)

  Reference: https://developers.binance.com/docs/derivatives/usds-margined-futures/market-data
}
