meta {
  name: Index Price Kline/Candlestick Data
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/fapi/v1/indexPriceKlines?pair=BTCUSDT&interval=1m
  body: none
  auth: inherit
}

params:query {
  pair: BTCUSDT
  interval: 1m
  ~startTime: 1623319461670
  ~endTime: 1641782889000
  ~limit: 50
}

settings {
  encodeUrl: true
}

docs {
  Index Price Kline/Candlestick Data

  GET /fapi/v1/indexPriceKlines (public — no API key required)

  Query parameters:
  - pair (example: BTCUSDT) — After CM migration, accepts both UM and CM pair values.
  - interval (example: 1m)
  - startTime (optional, example: 1623319461670) — Start time
  - endTime (optional, example: 1641782889000) — End time
  - limit (optional, example: 50)

  Reference: https://developers.binance.com/docs/derivatives/usds-margined-futures/market-data
}
