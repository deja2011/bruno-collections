meta {
  name: Recent Trades List
  type: http
  seq: 25
}

get {
  url: {{baseUrl}}/fapi/v1/trades?symbol=BTCUSDT
  body: none
  auth: inherit
}

params:query {
  symbol: BTCUSDT
  ~limit: 50
}

settings {
  encodeUrl: true
}

docs {
  Recent Trades List

  GET /fapi/v1/trades (public — no API key required)

  Query parameters:
  - symbol (example: BTCUSDT)
  - limit (optional, example: 50)

  Reference: https://developers.binance.com/docs/derivatives/usds-margined-futures/market-data
}
