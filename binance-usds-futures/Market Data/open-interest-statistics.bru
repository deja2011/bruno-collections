meta {
  name: Open Interest Statistics
  type: http
  seq: 19
}

get {
  url: {{baseUrl}}/futures/data/openInterestHist?symbol=BTCUSDT&period=5m
  body: none
  auth: inherit
}

params:query {
  symbol: BTCUSDT
  period: 5m
  ~limit: 50
  ~startTime: 1623319461670
  ~endTime: 1641782889000
}

settings {
  encodeUrl: true
}

docs {
  Open Interest Statistics

  GET /futures/data/openInterestHist (public — no API key required)

  Query parameters:
  - symbol (example: BTCUSDT)
  - period (example: 5m)
  - limit (optional, example: 50)
  - startTime (optional, example: 1623319461670)
  - endTime (optional, example: 1641782889000)

  Reference: https://developers.binance.com/docs/derivatives/usds-margined-futures/market-data
}
