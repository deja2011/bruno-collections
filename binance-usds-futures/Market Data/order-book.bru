meta {
  name: Order Book
  type: http
  seq: 20
}

get {
  url: {{baseUrl}}/fapi/v1/depth?symbol=BTCUSDT
  body: none
  auth: inherit
}

params:query {
  symbol: BTCUSDT
  ~limit: 50
}

settings {
  encodeUrl: true
}

docs {
  Order Book

  GET /fapi/v1/depth (public — no API key required)

  Query parameters:
  - symbol (example: BTCUSDT)
  - limit (optional, example: 50) — Valid limits:[5, 10, 20, 50, 100, 500, 1000]

  Reference: https://developers.binance.com/docs/derivatives/usds-margined-futures/market-data
}
