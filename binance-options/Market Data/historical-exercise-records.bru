  name: Historical Exercise Records
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/eapi/v1/exerciseHistory
  body: none
  auth: inherit
}

params:query {
  ~underlying: BTCUSDT
  ~startTime: 1623319461670
  ~endTime: 1641782889000
  ~limit: 20
}

settings {
  encodeUrl: true
}

docs {
  Historical Exercise Records

  GET /eapi/v1/exerciseHistory (public — no API key required)

  Query parameters:
  - underlying (optional, example: BTCUSDT) — Underlying asset.
  - startTime (optional, example: 1623319461670) — Start Time, e.g 1593511200000
  - endTime (optional, example: 1641782889000) — End Time, e.g 1593512200000
  - limit (optional, example: 20) — Number of result sets returned

  Reference: https://developers.binance.com/docs/derivatives/option/market-data
}
