meta {
  name: Index Price and Mark Price
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/dapi/v1/premiumIndex
  body: none
  auth: inherit
}

params:query {
  ~symbol: BTCUSD_PERP
  ~pair: BTCUSD
}

settings {
  encodeUrl: true
}

docs {
  Index Price and Mark Price

  GET /dapi/v1/premiumIndex (public — no API key required)

  Query parameters:
  - symbol (optional, example: BTCUSD_PERP)
  - pair (optional, example: BTCUSD)

  Reference: https://developers.binance.com/docs/derivatives/coin-margined-futures/market-data
}
