meta {
  name: Basis
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/futures/data/basis?pair=BTCUSD&contractType=PERPETUAL&period=5m
  body: none
  auth: inherit
}

params:query {
  pair: BTCUSD
  contractType: PERPETUAL
  period: 5m
  ~limit: 30
  ~startTime: 1623319461670
  ~endTime: 1641782889000
}

settings {
  encodeUrl: true
}

docs {
  Basis

  GET /futures/data/basis (public — no API key required)

  Query parameters:
  - pair (example: BTCUSD) — Pair.
  - contractType (example: PERPETUAL) — Contract type.
  - period (example: 5m) — Period interval.
  - limit (optional, example: 30) — Maximum number of records to return.
  - startTime (optional, example: 1623319461670)
  - endTime (optional, example: 1641782889000)

  Reference: https://developers.binance.com/docs/derivatives/coin-margined-futures/market-data
}
