meta {
  name: Symbol Price Ticker
  type: http
  seq: 22
}

get {
  url: {{baseUrl}}/dapi/v1/ticker/price
  body: none
  auth: inherit
}

params:query {
  ~symbol: BTCUSD_200626
  ~pair: BTCUSD
}

settings {
  encodeUrl: true
}

docs {
  Symbol Price Ticker

  GET /dapi/v1/ticker/price (public — no API key required)

  Query parameters:
  - symbol (optional, example: BTCUSD_200626) — Symbol
  - pair (optional, example: BTCUSD) — Pair

  Reference: https://developers.binance.com/docs/derivatives/coin-margined-futures/market-data
}
