  name: Compressed/Aggregate Trades List
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/dapi/v1/aggTrades?symbol=BTCUSD_PERP
  body: none
  auth: inherit
}

params:query {
  symbol: BTCUSD_PERP
  ~fromId: 1
  ~startTime: 1623319461670
  ~endTime: 1641782889000
  ~limit: 30
}

settings {
  encodeUrl: true
}

docs {
  Compressed/Aggregate Trades List

  GET /dapi/v1/aggTrades (public — no API key required)

  Query parameters:
  - symbol (example: BTCUSD_PERP) — Symbol
  - fromId (optional, example: 1) — ID to get aggregate trades from INCLUSIVE.
  - startTime (optional, example: 1623319461670) — Timestamp in ms to get aggregate trades from INCLUSIVE.
  - endTime (optional, example: 1641782889000) — Timestamp in ms to get aggregate trades until INCLUSIVE.
  - limit (optional, example: 30) — Maximum number of records to return.

  Reference: https://developers.binance.com/docs/derivatives/coin-margined-futures/market-data
}
