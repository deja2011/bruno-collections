meta {
  name: Long/Short Ratio
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/futures/data/globalLongShortAccountRatio?pair=BTCUSD&period=5m
  body: none
  auth: inherit
}

params:query {
  pair: BTCUSD
  period: 5m
  ~limit: 30
  ~startTime: 1623319461670
  ~endTime: 1641782889000
}

settings {
  encodeUrl: true
}

docs {
  Long/Short Ratio

  GET /futures/data/globalLongShortAccountRatio (public — no API key required)

  Query parameters:
  - pair (example: BTCUSD) — BTCUSD
  - period (example: 5m)
  - limit (optional, example: 30) — Maximum number of records to return.
  - startTime (optional, example: 1623319461670)
  - endTime (optional, example: 1641782889000)

  Reference: https://developers.binance.com/docs/derivatives/coin-margined-futures/market-data
}
