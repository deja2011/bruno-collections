meta {
  name: Open Interest Statistics
  type: http
  seq: 16
}

get {
  url: {{baseUrl}}/futures/data/openInterestHist?pair=BTCUSD&contractType=ALL&period=5m
  body: none
  auth: inherit
}

params:query {
  pair: BTCUSD
  contractType: ALL
  period: 5m
  ~limit: 30
  ~startTime: 1623319461670
  ~endTime: 1641782889000
}

settings {
  encodeUrl: true
}

docs {
  Open Interest Statistics

  GET /futures/data/openInterestHist (public — no API key required)

  Query parameters:
  - pair (example: BTCUSD)
  - contractType (example: ALL)
  - period (example: 5m)
  - limit (optional, example: 30) — Maximum number of records to return.
  - startTime (optional, example: 1623319461670)
  - endTime (optional, example: 1641782889000)

  Reference: https://developers.binance.com/docs/derivatives/coin-margined-futures/market-data
}
