meta {
  name: Old Trades Lookup (MARKET_DATA)
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/dapi/v1/historicalTrades?symbol=BTCUSD_PERP
  body: none
  auth: inherit
}

params:query {
  symbol: BTCUSD_PERP
  ~limit: 30
  ~fromId: 595103
}

settings {
  encodeUrl: true
}

docs {
  Old Trades Lookup (MARKET_DATA)

  GET /dapi/v1/historicalTrades (security type MARKET_DATA — requires the X-MBX-APIKEY header (set the apiKey environment variable); no signature)

  Query parameters:
  - symbol (example: BTCUSD_PERP) — Symbol
  - limit (optional, example: 30) — Maximum number of records to return.
  - fromId (optional, example: 595103) — TradeId to fetch from. Default gets most recent trades.

  Reference: https://developers.binance.com/docs/derivatives/coin-margined-futures/market-data
}
