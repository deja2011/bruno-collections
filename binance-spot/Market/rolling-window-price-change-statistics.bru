meta {
  name: Rolling window price change statistics
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/api/v3/ticker?symbol=BNBUSDT
  body: none
  auth: inherit
}

params:query {
  symbol: BNBUSDT
  ~symbols: ["BTCUSDT","BNBUSDT"]
  ~windowSize: 1m
  ~type: FULL
  ~symbolStatus: TRADING
}

settings {
  encodeUrl: true
}

docs {
  Rolling window price change statistics

  GET /api/v3/ticker (public — no API key required)

  Query parameters:
  - symbol (example: BNBUSDT) — Either `symbol` or `symbols` must be provided
  - symbols (optional, example: ["BTCUSDT","BNBUSDT"]) — Either `symbol` or `symbols` must be provided Examples of accepted format for the `symbols` parameter: ["BTCUSDT","BNBUSDT"] or %5B%22BTCUSDT%22,%22BNBUSDT%22%5D The maximum number of symbols allowed in a request is 100.
  - windowSize (optional, example: 1m) — Units cannot be combined (e.g. `1d2h` is not allowed).
  - type (optional, example: FULL)
  - symbolStatus (optional, example: TRADING)

  Reference: https://developers.binance.com/docs/binance-spot-api-docs/rest-api/market-data-endpoints
}
