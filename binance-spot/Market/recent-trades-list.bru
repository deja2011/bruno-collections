meta {
  name: Recent trades list
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/api/v3/trades?symbol=BNBUSDT
  body: none
  auth: inherit
}

params:query {
  symbol: BNBUSDT
  ~limit: 1
}

settings {
  encodeUrl: true
}

docs {
  Recent trades list

  GET /api/v3/trades (public — no API key required)

  Query parameters:
  - symbol (example: BNBUSDT)
  - limit (optional, example: 1)

  Reference: https://developers.binance.com/docs/binance-spot-api-docs/rest-api/market-data-endpoints
}
