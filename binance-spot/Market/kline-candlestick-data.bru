meta {
  name: Kline/Candlestick data
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v3/klines?symbol=BNBUSDT&interval=1s
  body: none
  auth: inherit
}

params:query {
  symbol: BNBUSDT
  interval: 1s
  ~startTime: 1735693200000
  ~endTime: 1735693200000
  ~timeZone: 0
  ~limit: 1
}

settings {
  encodeUrl: true
}

docs {
  Kline/Candlestick data

  GET /api/v3/klines (public — no API key required)

  Query parameters:
  - symbol (example: BNBUSDT)
  - interval (example: 1s)
  - startTime (optional, example: 1735693200000)
  - endTime (optional, example: 1735693200000)
  - timeZone (optional, example: 0) — Default: 0 (UTC)
  - limit (optional, example: 1)

  Reference: https://developers.binance.com/docs/binance-spot-api-docs/rest-api/market-data-endpoints
}
