meta {
  name: Old trade lookup
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v3/historicalTrades?symbol=BNBUSDT
  body: none
  auth: inherit
}

params:query {
  symbol: BNBUSDT
  ~limit: 1
  ~fromId: 1
}

settings {
  encodeUrl: true
}

docs {
  Old trade lookup

  GET /api/v3/historicalTrades (public — no API key required)

  Query parameters:
  - symbol (example: BNBUSDT)
  - limit (optional, example: 1)
  - fromId (optional, example: 1) — TradeId to fetch from. Default gets most recent trades.

  Reference: https://developers.binance.com/docs/binance-spot-api-docs/rest-api/market-data-endpoints
}
