meta {
  name: Symbol price ticker
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/api/v3/ticker/price
  body: none
  auth: inherit
}

params:query {
  ~symbol: BNBUSDT
  ~symbols: ["BTCUSDT","BNBUSDT"]
  ~symbolStatus: TRADING
}

settings {
  encodeUrl: true
}

docs {
  Symbol price ticker

  GET /api/v3/ticker/price (public — no API key required)

  Query parameters:
  - symbol (optional, example: BNBUSDT) — Parameter symbol and symbols cannot be used in combination. If neither parameter is sent, prices for all symbols will be returned in an array.
  - symbols (optional, example: ["BTCUSDT","BNBUSDT"]) — Parameter symbol and symbols cannot be used in combination. If neither parameter is sent, prices for all symbols will be returned in an array. Examples of accepted format for the symbols parameter: ["BTCUSDT","BNBUSDT"] or %5B%22BTCUSDT%22,%22BNBUSDT%22%5D
  - symbolStatus (optional, example: TRADING) — Filters for symbols that have this `tradingStatus`. For a single symbol, a status mismatch returns error `-1220 SYMBOL_DOES_NOT_MATCH_STATUS`. For multiple or all symbols, non-matching ones are simply excluded from the response.

  Reference: https://developers.binance.com/docs/binance-spot-api-docs/rest-api/market-data-endpoints
}
