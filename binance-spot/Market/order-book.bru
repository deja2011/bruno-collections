meta {
  name: Order book
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/v3/depth?symbol=SPCXBUSDT
  body: none
  auth: inherit
}

params:query {
  symbol: SPCXBUSDT
  ~limit: 1
  ~symbolStatus: TRADING
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Order book
  
  GET /api/v3/depth (public — no API key required)
  
  Query parameters:
  - symbol (example: BNBUSDT)
  - limit (optional, example: 1) — If limit > 5000, only 5000 entries will be returned.
  - symbolStatus (optional, example: TRADING) — Filters for symbols that have this `tradingStatus`. A status mismatch returns error `-1220 SYMBOL_DOES_NOT_MATCH_STATUS`.
  
  Reference: https://developers.binance.com/docs/binance-spot-api-docs/rest-api/market-data-endpoints
}
