meta {
  name: Query Reference Price Calculation
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/v3/referencePrice/calculation?symbol=BNBUSDT
  body: none
  auth: inherit
}

params:query {
  symbol: BNBUSDT
  ~symbolStatus: TRADING
}

settings {
  encodeUrl: true
}

docs {
  Query Reference Price Calculation

  GET /api/v3/referencePrice/calculation (public — no API key required)

  Query parameters:
  - symbol (example: BNBUSDT)
  - symbolStatus (optional, example: TRADING) — Supported values: `TRADING`, `HALT`, `BREAK`

  Reference: https://developers.binance.com/docs/binance-spot-api-docs/rest-api/market-data-endpoints
}
